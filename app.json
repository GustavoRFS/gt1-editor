{
  "expo": {
    "name": "GT-1 Editor",
    "slug": "gt1-editor",
    "scheme": "gt1editor",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-document-picker",
      "expo-file-system",
      "./plugins/with-usb-host"
    ],
    "android": {
      "package": "dev.gt1editor.app",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4d1a7d8-c5a3-466a-aa6d-c4e371e72a49"
      }
    },
    "owner": "gustavorfsdev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e4d1a7d8-c5a3-466a-aa6d-c4e371e72a49"
    }
  }
}
