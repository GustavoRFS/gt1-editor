{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GT-1 Editor",
  "version": "0.1.0",
  "identifier": "dev.gt1editor.app",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://localhost:8067",
    "beforeBuildCommand": "npm run export:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GT-1 Editor",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
